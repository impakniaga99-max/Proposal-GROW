    <script>
        function runAiDiagnostic() {
            const challenge = document.getElementById('business-challenge').value;
            const resultCard = document.getElementById('ai-result-card');
            const statusText = document.getElementById('ai-status-text');
            const contentBox = document.getElementById('ai-content-box');
            const diagSummary = document.getElementById('diag-summary');
            const diagModule = document.getElementById('diag-module');

            resultCard.classList.remove('hidden');
            statusText.classList.remove('hidden');
            statusText.textContent = "Sistem AI sedang mengimbas data dan parameter perniagaan...";
            contentBox.classList.add('hidden');

            setTimeout(() => {
                statusText.classList.add('hidden');
                contentBox.classList.remove('hidden');

                if (challenge === 'strategic') {
                    diagSummary.textContent = "Kesan kelemahan ketara pada hala tuju jangka panjang dan ketidakselarasan model perniagaan.";
                    diagModule.textContent = "Modul 1: Perancangan Strategik & Model Perniagaan";
                } else if (challenge === 'marketing') {
                    diagSummary.textContent = "Kadar penukaran pelanggan rendah dan kelemahan carian pasaran digital serta penjenamaan.";
                    diagModule.textContent = "Modul 2: Pemasaran & Penjenamaan + Pengurusan Jualan";
                } else if (challenge === 'financial') {
                    diagSummary.textContent = "Kadar susut aliran tunai kritikal dan kelemahan kawalan margin keuntungan operasi.";
                    diagModule.textContent = "Modul 4: Pengurusan Kewangan & Sesi One-on-One Khas";
                } else {
                    diagSummary.textContent = "Cabaran pengekalan pekerja mahir dan kelemahan struktur pengurusan sumber manusia.";
                    diagModule.textContent = "Modul 5: Pengurusan Bakat (Talent Management)";
                }
            }, 1200);
        }
    </script>
